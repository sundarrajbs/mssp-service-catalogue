# Copy to .env.local for local development (see README → Supabase setup).
# Only public values here: the anon/publishable key is safe in the browser because
# Row Level Security protects the data. Never add the service-role key: the app doesn't use it.

# Project URL: Supabase dashboard → Project Settings → API (or `npx supabase start` output locally)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon key (legacy) or publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: the site's public URL, used in sign-in emails. Defaults to the request's host.
# NEXT_PUBLIC_SITE_URL=https://catalogue.example.com

# Optional, server-only: a long random string that makes auth rate-limit keys unguessable.
# Generate with: openssl rand -hex 32
# AUTH_RATE_LIMIT_PEPPER=
